digraph ImplementIssue {
    graph [default_max_retries=0, max_node_visits=3]
    start [shape=Mdiamond]
    exit [shape=Msquare]
    context [script="python3 /experiment/scripts/issue-workflow.py context {{ inputs.job }}", on_failure="exit"]
    implement [backend="acp", acp.command="/experiment/scripts/issue-agent.sh", prompt="@prompts/implement.md", on_failure="exit"]
    result [script="python3 /experiment/scripts/issue-workflow.py result {{ inputs.job }}", on_failure="exit"]
    verify [script="python3 /experiment/scripts/issue-workflow.py verify {{ inputs.job }}"]
    retry [script="python3 /experiment/scripts/issue-workflow.py retry {{ inputs.job }}", on_failure="exit"]
    repair [backend="acp", acp.command="/experiment/scripts/issue-agent.sh", prompt="@prompts/repair.md", on_failure="exit", max_visits=2]
    pr [backend="acp", acp.command="/experiment/scripts/issue-agent.sh", prompt="@prompts/pr.md", on_failure="exit"]

    start -> context -> implement -> result -> verify
    verify -> pr [condition="outcome=succeeded"]
    verify -> retry
    retry -> repair -> result
    pr -> exit
}
